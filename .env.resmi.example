# Server RESMI (Tahap 1: Database Generus & Presensi). Salin menjadi .env.resmi.
# Dipakai oleh: pnpm resmi:migrate / resmi:setup / resmi:cron / resmi:check
# Project Supabase BARU, terpisah dari server uji.

APP_ENV=production

# Supabase → Connect → Session pooler (port 5432) untuk migrasi & setup.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Akun superadmin pertama (dibuat oleh pnpm resmi:setup).
SETUP_ADMIN_EMAIL=
SETUP_ADMIN_NAME=
SETUP_ADMIN_PASSWORD=
