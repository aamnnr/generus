# Salin menjadi .env.production.local di folder aplikasi di VPS (file ini tidak ikut git).
# Nilai *_KEY diambil dari file .env milik Supabase self-hosted (folder supabase/docker).
# PENTING: variabel NEXT_PUBLIC_* ditanam saat `pnpm build`; ubah → build ulang.

APP_ENV=production

# Postgres Supabase di VPS yang sama. Lewat Supavisor (pooler) bawaan docker:
#   user = postgres.<POOLER_TENANT_ID>, port 5432 (session) — lihat .env Supabase.
DATABASE_URL=postgresql://postgres.POOLER_TENANT_ID:POSTGRES_PASSWORD@127.0.0.1:5432/postgres
# Bukan serverless: pool boleh lebih besar dari di Vercel (per proses PM2).
DB_POOL_MAX=10

# Alamat publik API Supabase (Kong di belakang Nginx + HTTPS)
NEXT_PUBLIC_SUPABASE_URL=https://DOMAIN_API
NEXT_PUBLIC_SUPABASE_ANON_KEY=ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SERVICE_ROLE_KEY

NEXT_PUBLIC_APP_TIMEZONE=Asia/Jakarta
# on = semua modul; off = Tahap 1 (Generus & Presensi)
FEATURE_KURIKULUM=on

# Hanya untuk skrip setup awal (boleh dihapus setelahnya)
SETUP_ADMIN_EMAIL=
SETUP_ADMIN_NAME=
SETUP_ADMIN_PASSWORD=
