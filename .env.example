# Salin ke .env.local (untuk Next.js) dan .env (untuk drizzle-kit & script seed).

APP_ENV=development

# Supabase → Connect → Connection string (URI).
# .env (migrasi & seed): "Session pooler" port 5432.
# .env.local (aplikasi) & Vercel: "Transaction pooler" port 6543 — session pooler
# hanya ±15 klien dan habis saat aplikasi berjalan (EMAXCONNSESSION).
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Rahasia: hanya untuk script seed di komputer developer, jangan dipakai di browser.
SUPABASE_SERVICE_ROLE_KEY=

# Password untuk semua akun uji *@generus.test yang dibuat `pnpm db:seed`.
SEED_USER_PASSWORD=

# Zona waktu agenda (Asia/Jakarta = WIB, Asia/Makassar = WITA, Asia/Jayapura = WIT).
NEXT_PUBLIC_APP_TIMEZONE=Asia/Jakarta
