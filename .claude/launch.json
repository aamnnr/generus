{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-generus",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.NEXT_PUBLIC_BRAND='generus';require('child_process').spawn('pnpm',['dev'],{stdio:'inherit',shell:true,env:process.env}).on('exit',c=>process.exit(c))"
      ],
      "port": 3000
    },
    {
      "name": "prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "start",
        "-p",
        "3001"
      ],
      "port": 3001
    }
  ]
}